# Copy to ml/.env and fill in. Never commit ml/.env.

# --- ML service runtime ---
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
LOAD_BERT_MODEL=false

# --- Label export/import scripts in data/ (training only, not the service) ---
# Both values come from: Supabase dashboard > Project Settings > API
# SUPABASE_SERVICE_ROLE_KEY is the `service_role` secret, NOT the `anon` key —
# these scripts read every user's labels and must bypass RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
